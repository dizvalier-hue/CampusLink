@{
    ViewData["Title"] = "Home";
}

<style>
    .hero-section {
        padding: 100px 0;
    }

    .hero-title {
        font-size: 4.5rem;
        font-weight: 800;
        line-height: 1.1;
        color: #ffffff;
    }

        .hero-title span {
            background: -webkit-linear-gradient(#38bdf8, #818cf8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

    .hero-subtitle {
        font-size: 1.25rem;
        color: #94a3b8; /* Soft slate gray */
        margin-top: 20px;
        margin-bottom: 40px;
        font-weight: 400;
    }

    .badge-custom {
        background-color: rgba(56, 189, 248, 0.1); /* Transparent cyan */
        color: #38bdf8;
        border: 1px solid rgba(56, 189, 248, 0.3);
        font-size: 0.9rem;
        padding: 8px 16px;
        border-radius: 50px;
        font-weight: 600;
        display: inline-block;
        margin-bottom: 25px;
    }

    .hero-image {
        border-radius: 24px;
        box-shadow: 0 0 40px rgba(56, 189, 248, 0.2); /* Neon glow */
        background: linear-gradient(135deg, #1e1b4b, #0f172a); /* Deep purple/navy */
        border: 1px solid #312e81;
        padding: 60px 40px;
        color: white;
        text-align: center;
    }
</style>

<div class="container hero-section">
    <div class="row align-items-center">
        <!-- Left Side: Text -->
        <div class="col-lg-6">
            <span class="badge-custom">⚡ Verified Students Only</span>
            <h1 class="hero-title">Buy, Sell,<br><span>Tutor, & Trade.</span></h1>
            <p class="hero-subtitle">The exclusive marketplace for your campus. Stop overspending on things you only need for a semester. Find trusted peer tutors, and trade safely with students from your school.</p>

            <div class="d-flex gap-3">
                <a asp-controller="Listing" asp-action="Index" class="btn btn-lg px-5 py-3 shadow fw-bold text-white btn-glow">Browse Marketplace</a>

                @if (Context.Session.GetString("UserEmail") == null)
                {
                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-info btn-lg px-5 py-3 fw-bold" style="border-radius: 8px;">Sign Up</a>
                }
            </div>
        </div>

        <!-- Right Side: Graphic/Card -->
        <div class="col-lg-6 mt-5 mt-lg-0">
            <div class="hero-image">
                <h1 class="display-1 fw-bold mb-4">🎓</h1>
                <h3 class="fw-bold mb-3 text-white">Everything you need for the semester.</h3>
                <p class="mb-0 fs-5 text-secondary">From textbooks to tutoring, find it all on Campus Link.</p>
            </div>
        </div>
    </div>
</div>