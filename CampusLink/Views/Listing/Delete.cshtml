@model CampusLink.Models.Listing

@{
    ViewData["Title"] = "Delete Listing";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0" style="background-color: #1e293b; border-top: 5px solid #ef4444 !important; border-radius: 16px;">
                <div class="card-body p-5 text-center">
                    <h1 class="display-1 text-danger mb-3">⚠️</h1>
                    <h2 class="fw-bold text-white mb-3">Delete Listing?</h2>
                    <p class="text-secondary mb-4 fs-5">Are you sure you want to delete this listing? This action cannot be undone.</p>

                    <div class="bg-dark p-3 rounded mb-4" style="border: 1px solid #334155;">
                        <h4 class="text-white mb-1">@Model.Title</h4>
                        <h5 class="text-success fw-bold">@Model.Price.ToString("c")</h5>
                    </div>

                    <form method="post">
                        <input asp-for="Id" hidden />
                        <div class="d-flex gap-3 justify-content-center">
                            <button type="submit" class="btn btn-danger px-5 py-2 fw-bold" style="border-radius: 10px;">Yes, Delete It</button>
                            <a asp-action="Index" class="btn btn-outline-light px-5 py-2 fw-bold" style="border-radius: 10px;">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>