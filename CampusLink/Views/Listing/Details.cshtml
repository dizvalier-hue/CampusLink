@model CampusLink.Models.Listing

<div class="container p-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h2>@Model.Title</h2>
        </div>
        <div class="card-body">
            <h4 class="text-success">Price: @Model.Price.ToString("c")</h4>
            <p><strong>Category:</strong> @Model.Category?.Name</p>
            <p><strong>Type:</strong> @Model.Type</p>
            <p><strong>Posted by:</strong> @Model.PosterEmail</p>
            <hr />
            <h5>Description:</h5>
            <p>@Model.Description</p>

            <div class="mt-4">
                <a asp-controller="Booking" asp-action="Create" asp-route-listingId="@Model.Id" class="btn btn-success btn-lg">
                    Book / Reserve this Service
                </a>
                <a asp-action="Index" class="btn btn-secondary btn-lg">Back to Marketplace</a>
            </div>
        </div>
    </div>
</div>