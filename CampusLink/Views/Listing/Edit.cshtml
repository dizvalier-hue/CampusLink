@model CampusLink.Models.Listing

@{
    ViewData["Title"] = "Edit Listing";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0" style="background-color: #1e293b; border-radius: 16px;">
                <div class="card-header border-bottom border-secondary py-3" style="background-color: transparent;">
                    <h3 class="text-white mb-0">Edit Listing: @Model.Title</h3>
                </div>
                <div class="card-body p-4">
                    <form method="post">
                        <!-- Hidden fields to keep ID and Date intact -->
                        <input asp-for="Id" hidden />
                        <input asp-for="CreatedDateTime" hidden />

                        <div asp-validation-summary="All" class="text-danger mb-3 fw-bold"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Title" class="form-label text-light fw-bold"></label>
                                <input asp-for="Title" class="form-control" />
                                <span asp-validation-for="Title" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Price" class="form-label text-light fw-bold"></label>
                                <input asp-for="Price" class="form-control" />
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label text-light fw-bold"></label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Type" class="form-label text-light fw-bold"></label>
                                <select asp-for="Type" asp-items="Html.GetEnumSelectList<CampusLink.Models.Enums.ListingType>()" class="form-select"></select>
                                <span asp-validation-for="Type" class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="CategoryId" class="form-label text-light fw-bold">Category</label>
                                <select asp-for="CategoryId" asp-items="@ViewBag.CategoryList" class="form-select"></select>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="PosterEmail" class="form-label text-light fw-bold"></label>
                                <input asp-for="PosterEmail" class="form-control" />
                                <span asp-validation-for="PosterEmail" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-warning w-50 fw-bold py-2" style="border-radius: 8px;">Save Changes</button>
                            <a asp-action="Index" class="btn btn-outline-light w-50 fw-bold py-2" style="border-radius: 8px;">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}