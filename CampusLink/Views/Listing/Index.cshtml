@model IEnumerable<CampusLink.Models.Listing>

@{
    ViewData["Title"] = "Campus Link Marketplace";
}

<style>
    .listing-card {
        border-radius: 16px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .listing-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px -5px rgba(56, 189, 248, 0.2) !important;
            border-color: #38bdf8 !important;
        }

    .price-text {
        color: #2dd4bf; /* Bright Neon Teal */
        font-size: 1.5rem;
        font-weight: 800;
    }

    .btn-view {
        background-color: rgba(56, 189, 248, 0.1);
        color: #38bdf8;
        font-weight: 600;
        border: 1px solid rgba(56, 189, 248, 0.3);
    }

        .btn-view:hover {
            background-color: #38bdf8;
            color: #0f172a;
        }
</style>

<div class="container p-4">
    <div class="row pt-4 mb-4 align-items-center">
        <div class="col-6">
            <h2 class="fw-bold text-white">Campus Link Marketplace</h2>
        </div>
        <div class="col-6 text-end">
            @if (Context.Session.GetString("UserEmail") != null)
            {
                <a asp-controller="Listing" asp-action="Create" class="btn btn-glow px-4 py-2">
                    + Post New Listing
                </a>
            }
        </div>
    </div>

    <div class="row">
        @foreach (var obj in Model)
        {
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card h-100 listing-card shadow-sm">
                    <div class="card-header border-0 pt-4 pb-0 px-4" style="background-color: transparent;">
                        <span class="badge rounded-pill float-end bg-primary px-3 py-2">@obj.Type</span>
                        <span class="badge rounded-pill bg-secondary px-3 py-2">@obj.Category?.Name</span>
                    </div>

                    <div class="card-body px-4">
                        <h4 class="card-title fw-bold mb-3 text-white">@obj.Title</h4>
                        <h5 class="price-text mb-3">@obj.Price.ToString("c")</h5>
                        <p class="card-text text-secondary small mb-1">
                            <i class="bi bi-person-circle"></i> Posted by: <span class="text-info">@obj.PosterEmail</span>
                        </p>
                    </div>

                    <!-- UPDATED FOOTER HERE -->
                    <div class="card-footer border-0 d-flex justify-content-between p-3" style="background-color: transparent; border-top: 1px solid #334155 !important;">
                        <a asp-action="Details" asp-route-id="@obj.Id" class="btn btn-view flex-grow-1 me-2 py-2" style="border-radius: 8px; white-space: nowrap;">View / Book</a>

                        @if (Context.Session.GetString("UserEmail") != null)
                        {
                            <div class="d-flex flex-grow-1 gap-2">
                                <a asp-action="Edit" asp-route-id="@obj.Id" class="btn btn-outline-warning w-50" style="border-radius: 8px; white-space: nowrap;">Edit</a>
                                <a asp-action="Delete" asp-route-id="@obj.Id" class="btn btn-outline-danger w-50" style="border-radius: 8px; white-space: nowrap;">Delete</a>
                            </div>
                        }
                    </div>
                    <!-- END OF UPDATED FOOTER -->

                </div>
            </div>
        }
    </div>
</div>